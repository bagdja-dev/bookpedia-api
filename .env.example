## ─── Server ─────────────────────────────────────────────
PORT=5020
NODE_ENV=development

## ─── Database (Supabase Postgres) ───────────────────────
# Local Supabase (default, lihat supabase/config.toml — blok port 54350-54354,
# di-offset supaya tidak bentrok dengan instance Supabase lain di mesin dev:
# bagdja-payment-service 54320-54329, shipping-services 54330-54339,
# bagdja-website-api 54340-54344).
# Production: gunakan connection string dari Supabase project Novelo
# (terpisah dari core & app lain — lihat execution-plan.md Fase 0).
DATABASE_URL=postgresql://postgres:postgres@localhost:54352/postgres

## ─── Supabase (untuk migrations & storage) ──────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_STORAGE_BUCKET=novelo-assets

## ─── Bagdja Platform Integration ────────────────────────
# Auth service — dipakai JwtAuthGuard (fallback JWKS/`/auth/me`) untuk
# verifikasi token user login (penulis di novelo-studio, pembaca di novelo-app).
BAGDJA_AUTH_API=https://auth.bagdja.com
JWKS_URL=https://auth.bagdja.com/.well-known/jwks.json

# Client credentials untuk service-to-service (di-issue oleh bagdja-auth) —
# WAJIB didaftarkan di bagdja-console sebagai client app baru ("bagdja-novelo")
# sebelum fallback JWKS/`/auth/me` & logger @bagdja/node-sdk bisa berfungsi.
CLIENT_APP_ID=bagdja-novelo
CLIENT_APP_SECRET=change-me

# Log service (opsional, non-blocking — BagdjaLogger dari @bagdja/node-sdk)
BAGDJA_LOG_URL=http://localhost:4087
BAGDJA_SERVICE_NAME=bagdja-novelo-api

## ─── JWT ─────────────────────────────────────────────────
# Secret untuk verifikasi JWT lokal (sama dengan yang dipakai bagdja-auth) —
# hanya jalur pertama JwtAuthGuard; kalau beda dari secret bagdja-auth
# (mis. dev vs prod SSO), guard otomatis fallback ke JWKS lalu /auth/me di atas.
JWT_SECRET=your-jwt-secret

## ─── Swagger (Basic Auth) ───────────────────────────────
SWAGGER_USER=admin
SWAGGER_PASSWORD=change-me

## ─── Fase 4: Multi-Tenant Platform (§4.1, custom domain scaffold) ─
# Inert sampai infra §4.3 siap — lihat platform-domains module.
# IP target A-record untuk instruksi domain custom Platform Owner. Kosong =
# auto-detect via api.ipify.org (cocok kalau server ini yang expose IP publik
# langsung; isi manual kalau di belakang load balancer/NAT).
CUSTOM_DOMAIN_TARGET_IP=
# Shared secret endpoint internal /internal/traefik-config (dipanggil
# cron/script di host, BUKAN browser) — WAJIB diisi sebelum §4.3 infra jalan.
TRAEFIK_PROVIDER_SECRET=change-me
# URL internal (Docker network) bagdja-novelo-app — dipakai
# buildTraefikDynamicConfig() supaya provider Traefik self-contained.
NOVELO_APP_INTERNAL_URL=http://novelo-app:3000

## ─── Belum dipakai Fase 0 (placeholder untuk fase lanjut) ─
# bagdja-storage-service — upload cover Library/Book (Fase 1+). Kalau masih
# dogfooding belum matang, fallback storage sendiri (pola bagdja-website-api).
BAGDJA_STORAGE_API=http://localhost:4008
# bagdja-payment-service — wallet/koin, monetisasi bab berbayar (Fase 2+, MVP tidak dipakai).
BAGDJA_PAYMENT_API=http://localhost:4006
# bagdja-event-service — notifikasi Chapter baru terbit (Fase 3+, opsional).
EVENT_SERVICE_URL=http://localhost:4085
